# mockups are published.
/.shots/
/.iconsheet.png
/.iconsheet_big.png
/probe.log
/tools/*
!/tools/subset_ui_font.py
!/tools/_repackage_portable.py

# One-off probe scripts; only the packaging script ships.
/scripts/*
!/scripts/package.ps1

